CC              = gcc
C++             = g++
LD_HOME         = $(HOME)
AR              = ar
SYSTEM_INCL     =
COMMON_INCL     = -I$(LD_HOME)/include
LOCAL_INCL      = -I$(LD_HOME)/Dev/Library/include
INCLUDE         = $(LOCAL_INCL) $(COMMON_INCL) $(SYSTEM_INCL)
SUBDIRS= sample


LIBNAME         =$(LD_HOME)/lib/libkbClib.a

CFLAGS          = -g -c $(INCLUDE)
ARFLAGS         = -ruv

.SUFFIXES       : .cc .c .o .cp

.c.o            :
	$(CC) $(CFLAGS) $*.c

.cc.o            :
	$(C++) $(CFLAGS) $*.cc

# OBJS list
OBJS            = semainit.o semaop.o
all : lib
lib             : $(OBJS)
	$(AR) $(ARFLAGS) $(LIBNAME) $(OBJS)
	@make clean

clean           :
	@for i in $(SUBDIRS); do (cd ./$$i && echo $$i: && $(MAKE) $@) done || exit 1

	 rm -f *.o core
