LD_HOME         = $(RUN_HOME)
COMMON_INCL     = 
LOCAL_INCL      = -I$(LD_HOME)/include
INCLUDE         = $(LOCAL_INCL) $(COMMON_INCL)

COMMON_LIB_PATH = 
LOCAL_LIB_PATH  = -L$(LD_HOME)/lib
LIB_PATH        = $(COMMON_LIB_PATH) $(LOCAL_LIB_PATH)

CFLAGS          = -g -c $(INCLUDE) -D_RDMSIZE

COMMON_LIBS     =
LOCAL_LIBS      = -lnhcommon -lisam
LIBS            = $(LOCAL_LIBS) $(COMMON_LIBS)

.SUFFIXES       : .c .o .cp

.c.o            :
	$(CC) $(CFLAGS) $*.c

all :	semtest

semtest : semtest.o
	$(CC) -o semtest semtest.o $(LIB_PATH) $(LIBS)
	strip $@
	 rm -f *.o core LOG.dat
#	mv $@ $(RUN_HOME)/bin

clean           :
	 rm -f *.o core LOG.dat
