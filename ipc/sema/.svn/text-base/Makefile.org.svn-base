LD_HOME         = $(SRC_HOME)
AR              = ar
SYSTEM_INCL     =
COMMON_INCL     = -I$(LD_HOME)/include
LOCAL_INCL      =
INCLUDE         = $(LOCAL_INCL) $(COMMON_INCL) $(SYSTEM_INCL)


LIBNAME         =$(LD_HOME)/lib/libnhcommon.a

CFLAGS          = -g -c -D_REENTRANT $(INCLUDE)
ARFLAGS         = ruv

.SUFFIXES       : .c .o

.c.o            :
	$(CC) $(CFLAGS) $*.c

# OBJS list
OBJS            =sema.o

all : lib

lib             : $(OBJS)
	$(AR) $(ARFLAGS) $(LIBNAME) $(OBJS)

clean           :
	 rm -f *.o core
