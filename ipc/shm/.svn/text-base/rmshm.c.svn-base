#include <stdio.h>
#include <sys/types.h>
#include <sys/ipc.h>
#include <sys/shm.h>

extern int lGetshmid();

/*#@
**	Function 	: Remove shared memory by shmkey
**	Syntax   	: int lRemoveshm(key_t shmkey);
**  Prototype in: 
**  Libary    in:
**	Remark		:  
**	Return Value: On success , positive value 
**				  Otherwise,   error -1
**  See also 	: lGetshmid lOpenshm lMakeshm lAttachshm lDetachshm lRemoveshm 
**			      		
**#$ 
*/

int lRemoveshm(key_t shmkey)
{
	int shmid;
	int rtn;
	if((shmid=lGetshmid(shmkey))<0) return -1;
	if(shmctl(shmid,IPC_RMID,0)<0) return -1;
	return 1;
} 
